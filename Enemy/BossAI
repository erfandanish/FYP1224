using UnityEngine;
using UnityEngine.UI;
using System.Collections;
using System.Collections.Generic;
using UnityEngine.SceneManagement;

public class BossAI : MonoBehaviour
{   
    
    private bool isPhase2 = false;

    public float speed = 2f;
    public float attackCooldown = 3f;
    private float attackTimer = 0f;
    
    private bool facingRight = true;
    private Transform player;

    private Animator animator;
    private Rigidbody2D rb;

    public int attackDamage = 1;
    public Transform attackPoint;
    public float attackRange = 1.5f;
    public LayerMask playerLayer;
    public LayerMask groundLayer;

    private bool isAttacking = false;
    public bool isStunned = false;
    
    private SpriteRenderer spriteRenderer;
    public Slider healthBar;
    public int maxHealth = 10;
    private int currentHealth;
    public float detectionRadius = 10f;
    public LayerMask detectionLayer;
    private bool playerDetected = false;
    public GameObject key;
    

    void Start()
    {
        currentHealth = maxHealth;
        healthBar.maxValue = maxHealth;
        healthBar.value = currentHealth;
        animator = GetComponent<Animator>();
        rb = GetComponent<Rigidbody2D>();
        player = GameObject.FindGameObjectWithTag("Player")?.transform;
        spriteRenderer = GetComponent<SpriteRenderer>();

         if (key != null)
        {
            key.SetActive(false);  // Hide the key at the start
        }
        else
        {
            Debug.LogError("Key object is not assigned!");
        }
    }

    void Update()
    {   
        if (Input.GetKeyDown(KeyCode.P))
        {
            Debug.Log("Phase 2 triggered manually!");
            EnterPhase2();
        }

        if (currentHealth <= maxHealth / 2 && !isPhase2)
        {
            EnterPhase2();
        }

        playerDetected = Physics2D.OverlapCircle(transform.position, detectionRadius, detectionLayer);

        if (playerDetected && player != null)
        {
            float direction = Mathf.Sign(player.position.x - transform.position.x);
            if ((direction > 0 && !facingRight) || (direction < 0 && facingRight))
            {
                Flip();
            }

            Walk();

            attackTimer += Time.deltaTime;
            if (attackTimer >= attackCooldown)
            {
                Attack();
                attackTimer = 0;  // Reset attack cooldown
            }
        }
        else
        {
            animator.SetBool("isWalking", false);
        }
    }

    void Walk()
    {
        if (isStunned) return;

        float direction = player.position.x - transform.position.x;

        // Introduce a dead zone to prevent frequent flipping
        float flipThreshold = 0.5f; // Adjust this value as needed

        if (Mathf.Abs(direction) > flipThreshold)
        {
            rb.linearVelocity = new Vector2(Mathf.Sign(direction) * speed, rb.linearVelocity.y);

            if ((direction > 0 && !facingRight) || (direction < 0 && facingRight))
            {
                Flip();
            }

            animator.SetBool("isWalking", true);
        }
        else
        {
            rb.linearVelocity = new Vector2(0, rb.linearVelocity.y);
            animator.SetBool("isWalking", false);
        }
    }


    void Flip()
    {
        facingRight = !facingRight;
        transform.localScale = new Vector3(-transform.localScale.x, transform.localScale.y, transform.localScale.z);
    }

    void Attack()
    {   
        isAttacking = true;

        int attackChoice = isPhase2 ? Random.Range(1, 4) : Random.Range(1, 3);
        animator.SetInteger("attackType", attackChoice);
        animator.SetTrigger("attack");

        if (attackChoice == 3)
        {
            StartCoroutine(RapidCombo());
        }

        Debug.Log("Boss chose attack type: " + attackChoice);
    }

    public void MeleeAttack()
    {
        Collider2D[] hitPlayers = Physics2D.OverlapCircleAll(attackPoint.position, attackRange, playerLayer);

        foreach (Collider2D player in hitPlayers)
        {
            Player playerScript = player.GetComponent<Player>();
            if (playerScript != null)
            {
                playerScript.TakeDamage(attackDamage);
                Debug.Log("Boss hit the player!");
            }
        }
    }

    public void FinishAttack()
    {
        isAttacking = false;
        animator.ResetTrigger("attack");
    }

    void EnterPhase2()
    {
        isPhase2 = true;
        spriteRenderer.color = Color.red;
        animator.SetInteger("phase", 2);
        StartCoroutine(ChangeColorSmoothly());
        StartCoroutine(FlashEffect());

        speed += 1.5f;
        attackCooldown -= 0.5f;
    }

    public void TakeDamage(int damage)
    {
        currentHealth -= damage;
        healthBar.value = currentHealth;
        animator.SetTrigger("isHurt");
        Debug.Log("Boss Taking Damage! Current Health:" + currentHealth);

        if (currentHealth <= 0)
        {
            Die();
        }
    }

    void Die()
    {   
        Debug.Log("Boss Defeated!");
        StopAllCoroutines();
        spriteRenderer.enabled = true;
        animator.SetBool("isDead", true);
        GetComponent<Collider2D>().enabled = false;
        this.enabled = false;
        if (key != null) 
        {
            key.SetActive(true);
        }
        else
        {
            Debug.LogError("Key object is not assigned!");
        }
        
        StartCoroutine(LoadEndingSceneAfterDelay());

    }

    void OnDrawGizmosSelected()
    {
        Gizmos.color = Color.red;
        Gizmos.DrawWireSphere(attackPoint.position, attackRange);

        Gizmos.color = Color.green;
        Gizmos.DrawWireSphere(transform.position, detectionRadius);
    }

    IEnumerator RapidCombo()
    {
        animator.SetTrigger("attack1");
        yield return new WaitForSeconds(0.5f); 
        animator.SetTrigger("attack2");
    }


    IEnumerator LoadEndingSceneAfterDelay()
    {
        yield return new WaitForSeconds(2.5f); // let death animation play

        if (LevelMusicManager.instance != null)
        {
            Destroy(LevelMusicManager.instance.gameObject);
        }

        SceneManager.LoadScene("EndingScene");
    }


    IEnumerator ChangeColorSmoothly()
    {
        Color startColor = spriteRenderer.color;
        Color endColor = Color.red;
        float duration = 1f;
        float elapsed = 0f;

        while (elapsed < duration)
        {
            spriteRenderer.color = Color.Lerp(startColor, endColor, elapsed / duration);
            elapsed += Time.deltaTime;
            yield return null;
        }

        spriteRenderer.color = endColor;
    }

    IEnumerator FlashEffect()
    {
        for (int i = 0; i < 3; i++)
        {
            if (currentHealth <= 0) yield break;

            spriteRenderer.enabled = false;
            yield return new WaitForSeconds(0.1f);
            spriteRenderer.enabled = true;
            yield return new WaitForSeconds(0.1f);
        }
    } 
}
