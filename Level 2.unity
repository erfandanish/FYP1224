      value: 
      objectReference: {fileID: 1439621541}
    - target: {fileID: 831257667756554903, guid: 1a225580f72c2f14096cd7093d92f16c, type: 3}
      propertyPath: dialogueLines.Array.data[0].lineText
      value: "\u201CSo this is it\u2026 Zarnoth\u2019s stronghold.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 831257667756554903, guid: 1a225580f72c2f14096cd7093d92f16c, type: 3}
      propertyPath: dialogueLines.Array.data[1].lineText
      value: "\u201CEvery stone here reeks of blood and suffering.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 831257667756554903, guid: 1a225580f72c2f14096cd7093d92f16c, type: 3}
      propertyPath: dialogueLines.Array.data[2].lineText
      value: "\u201CI can hear them\u2026 his minions. They're waiting.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 831257667756554903, guid: 1a225580f72c2f14096cd7093d92f16c, type: 3}
      propertyPath: dialogueLines.Array.data[3].lineText
      value: "\u201CThere no turning back now. \u201D\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 831257667756554903, guid: 1a225580f72c2f14096cd7093d92f16c, type: 3}
      propertyPath: dialogueLines.Array.data[4].lineText
      value: "\"For the fallen\u2026 for the future.\""
      objectReference: {fileID: 0}
    - target: {fileID: 831257667756554903, guid: 1a225580f72c2f14096cd7093d92f16c, type: 3}
      propertyPath: dialogueLines.Array.data[0].speakerName
