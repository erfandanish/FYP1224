using UnityEngine;
using UnityEngine.UI;
using System.Collections;
using System.Collections.Generic;
using Unity.Cinemachine;
using UnityEngine.SceneManagement;
public class Player : MonoBehaviour
{
    public Animator animator;
    public Rigidbody2D rb;
    public float jumpHeight = 5f;
    public bool isGround = true;
    public bool isRunning;
    private float movement;
    public float moveSpeed = 5f;
    private bool facingRight = true;
    private int comboCount = 0;
    private float lastClickTime = 0f;
    private float comboDelay = 1f;
    public int maxHealth = 4;
    public int currentHealth;
    public HealthBar healthBar;
    public Transform attackPoint;
    public float attackRadius = 1f;
    public LayerMask attackLayer;
    private SpriteRenderer spriteRenderer;
    
    public AudioClip attack1SFX;
    public AudioClip attack1NoEnemySFX;
    public AudioClip attack2SFX;
    public AudioClip attack2NoEnemySFX;
    public AudioClip runAttackSFX;
    public AudioClip runAttackNoEnemySFX;
    public AudioClip jumpSFX;
    public AudioClip hitSFX;
    public AudioClip deathSFX;
    public AudioClip collectSFX;
    public AudioClip heartSFX;
    
    
    public AudioSource backgroundMusic;
    private AudioSource audioSource;
    public GameObject gameOverText;
    public Button retryButton;
    public int currentCrystal = 0;
    public Text currentCrystalText;
    public GameObject victoryUI;
    private bool isWon = false;
    public HitIndicator hitIndicator;
    
    void Start() 
    {
        
        Time.timeScale = 1f;
        currentHealth = maxHealth;
        healthBar.SetMaxHealth(maxHealth);
        spriteRenderer = GetComponent<SpriteRenderer>();
        audioSource = GetComponent<AudioSource>();
        
        if (gameOverText != null)
            gameOverText.SetActive(false);
        if (retryButton != null) {
            retryButton.gameObject.SetActive(false);
            retryButton.onClick.AddListener(RestartGame);
        }

        

            
    }

    void Update()
    {   
        if (isWon) { 
            animator.SetFloat("Run", 0); 
            movement = 0f;
            moveSpeed = 0f;
            return;
        }

        if (currentHealth <= 0) {
            Die();
        }

        currentCrystalText.text = currentCrystal.ToString();
        movement = Input.GetAxis("Horizontal");

        if (movement < 0f && facingRight)
        {
            transform.eulerAngles = new Vector3(0f, -180f, 0f);
            facingRight = false;
        }
        else if (movement > 0f && !facingRight)
        {
            transform.eulerAngles = new Vector3(0f, 0f, 0f);
            facingRight = true;
        }

        if (Input.GetKey(KeyCode.Space) && isGround)
        {
            Jump();
            isGround = false;
            animator.SetBool("Jump", true);
        }

        if (Mathf.Abs(movement) > 0.1f)
        {
            animator.SetFloat("Run", 1f);
            isRunning = true;
        }
        else
        {
            animator.SetFloat("Run", 0f);
            isRunning = false;
        }

        if (Input.GetMouseButtonDown(0) && isGround) // Prevent attacking mid-air
    {
        if (isRunning)
        {
            animator.SetTrigger("RunAttack");
            PlayAttackSound(runAttackSFX, runAttackNoEnemySFX);
            comboCount = 0;
        }
        else
        {
            if (Time.time - lastClickTime > comboDelay)
            {
                comboCount = 0;
            }

            comboCount++;
            lastClickTime = Time.time;

            if (comboCount == 1)
            {
                animator.SetTrigger("Attack1");
                PlayAttackSound(attack1SFX, attack1NoEnemySFX);
            }
            else if (comboCount == 2)
            {
                animator.SetTrigger("Attack2");
                PlayAttackSound(attack2SFX, attack2NoEnemySFX);
                comboCount = 0;
            }
        }
    }
}


    private void FixedUpdate()
    {
        transform.position += new Vector3(movement, 0f, 0f) * Time.fixedDeltaTime * moveSpeed;
    }

    void Jump()
    {
        rb.AddForce(new Vector2(0f, jumpHeight), ForceMode2D.Impulse);
        PlaySound(jumpSFX);
    }

    private void OnCollisionEnter2D(Collision2D collision)
    {
        if (collision.gameObject.tag == "Ground")
        {
            isGround = true;
            animator.SetBool("Jump", false);
        }
    }

public void Attack()
{
    Collider2D collInfo = Physics2D.OverlapCircle(attackPoint.position, attackRadius, attackLayer);
    if (collInfo)
    {
        // Check if hit object has PatrolEnemy or Boss component
        PatrolEnemy patrolEnemy = collInfo.GetComponent<PatrolEnemy>();
        BossAI boss = collInfo.GetComponent<BossAI>();

        if (patrolEnemy != null && !patrolEnemy.isStunned)
        {
            Vector2 attackDirection = (patrolEnemy.transform.position - transform.position).normalized;
            patrolEnemy.TakeDamage(1, attackDirection);
            Debug.Log("Hit PatrolEnemy with Attack1!");
        }
        else if (boss != null) // Boss doesn't have 'isStunned', so just check if it's not null
        {
            Vector2 attackDirection = (boss.transform.position - transform.position).normalized;
            boss.TakeDamage(1);
            Debug.Log("Hit Boss with Attack1!");
        }
    }
}

public void Attack2()
{
    Collider2D collInfo = Physics2D.OverlapCircle(attackPoint.position, attackRadius, attackLayer);
    if (collInfo)
    {
        PatrolEnemy patrolEnemy = collInfo.GetComponent<PatrolEnemy>();
        BossAI boss = collInfo.GetComponent<BossAI>();

        if (patrolEnemy != null && !patrolEnemy.isStunned)
        {
            Vector2 attackDirection = (patrolEnemy.transform.position - transform.position).normalized;
            patrolEnemy.TakeDamage(1, attackDirection);
            Debug.Log("Hit PatrolEnemy with Attack2!");
        }
        else if (boss != null)
        {
            Vector2 attackDirection = (boss.transform.position - transform.position).normalized;
            boss.TakeDamage(1);
            Debug.Log("Hit Boss with Attack2!");
        }
    }
}

public void RunAttack()
{
    Collider2D collInfo = Physics2D.OverlapCircle(attackPoint.position, attackRadius, attackLayer);
    if (collInfo)
    {
        PatrolEnemy patrolEnemy = collInfo.GetComponent<PatrolEnemy>();
        BossAI boss = collInfo.GetComponent<BossAI>();

        if (patrolEnemy != null && !patrolEnemy.isStunned)
        {
            Vector2 attackDirection = (patrolEnemy.transform.position - transform.position).normalized;
            patrolEnemy.TakeDamage(1, attackDirection);
            Debug.Log("Hit PatrolEnemy with Run Attack!");
        }
        else if (boss != null)
        {
            Vector2 attackDirection = (boss.transform.position - transform.position).normalized;
            boss.TakeDamage(1);
            Debug.Log("Hit Boss with Run Attack!");
        }
    }
}





    void OnDrawGizmosSelected()
    {
        if (attackPoint == null) {
            return;
        }
        Gizmos.DrawWireSphere(attackPoint.position, attackRadius);
    }

    public void TakeDamage(int damage)
    {
        if (currentHealth <= 0) {
            return;
        }
        
        hitIndicator.TriggerHitIndicator();
        StartCoroutine(FlashRed());
        PlaySound(hitSFX);
        currentHealth -= damage;
        healthBar.SetHealth(currentHealth);
    }

    private IEnumerator FlashRed()
    {
        spriteRenderer.color = Color.red;
        yield return new WaitForSeconds(0.2f);
        spriteRenderer.color = Color.white;
    }

    private void OnTriggerEnter2D(Collider2D other)
    {
        if (other.gameObject.tag == "Trap") {
            TakeDamage(1);
        }

        if (other.gameObject.tag == "Crystal") {
            currentCrystal++;
            PlaySound(collectSFX);
            Destroy(other.gameObject);
        }
        
        if (other.gameObject.tag == "Health") {
            Heal(1);
            PlaySound(heartSFX);
            Destroy(other.gameObject);
        }

        if (other.gameObject.tag == "Key") {
            victoryUI.SetActive(true);
            isWon = true;

            if (backgroundMusic != null) {
                backgroundMusic.Stop();
            }

            if (retryButton != null) {
                retryButton.gameObject.SetActive(true);
                retryButton.onClick.RemoveAllListeners();
                retryButton.onClick.AddListener(RestartGame);
                Destroy(other.gameObject);
            }

            if (audioSource.isPlaying)
                audioSource.Stop();
            
            Time.timeScale = 0f;
        }
    }

    public void Heal(int amount)
{
    currentHealth += amount; 
    if (currentHealth > maxHealth)
    {
        currentHealth = maxHealth; // Prevent overhealing
    }

    healthBar.SetHealth(currentHealth);

    Debug.Log("Player healed! Current health: " + currentHealth);
}





    public void Die()
    {
        Debug.Log(this.transform.name + " Died.");
        PlaySound(deathSFX);

        if (hitIndicator != null)
        {
            hitIndicator.HideHitIndicatorImmediately();
        }
    
       
       if (gameOverText != null)
            gameOverText.SetActive(true);

        if (retryButton != null)
            retryButton.gameObject.SetActive(true);

        

        Time.timeScale = 0f;
        
    }

    public void RestartGame() {
    
        Time.timeScale = 1f; // Resume time
        SceneManager.LoadScene(SceneManager.GetActiveScene().buildIndex);//Reload scene

        
    }

    private void PlaySound(AudioClip clip)
    {
        if (clip != null)
        {
            audioSource.PlayOneShot(clip);
        }
    }

    private void PlayAttackSound(AudioClip hitSound, AudioClip missSound)
    {
        Collider2D collInfo = Physics2D.OverlapCircle(attackPoint.position, attackRadius, attackLayer);
        if (collInfo)
        {
            PlaySound(hitSound);
        }
        else
        {
            PlaySound(missSound);
        }
    }
}
